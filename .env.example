# Server & App Configuration
PORT=3000
APP_URL="http://localhost:3000"

# Database Configuration (SQLite default, PostgreSQL supported)
DATABASE_URL="file:./dev.db"

# Security & Encryption (32-byte secret for AES-256-GCM encryption of stored API keys & OAuth tokens)
APP_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
SESSION_SECRET="super-secure-formgenius-session-secret-change-in-production"

# AI Provider Keys (Optional: Can also be configured directly via UI)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Google OAuth 2.0 (For self-hosted Google Forms integration)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
